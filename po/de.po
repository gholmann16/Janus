#: data/dev.pantheum.janus.metainfo.xml.in:5
msgid "Janus"
msgstr "Janus"

#: data/dev.pantheum.janus.metainfo.xml.in:6
msgid "Simple text editor"
msgstr "Einfacher Texteditor"

#: data/dev.pantheum.janus.metainfo.xml.in:25
msgid ""
"Janus is a simple, native linux text editor. Supports UTF-8 and binary data "
"through its fallback binary editing mode. Spiritual successor to leafpad. "
"Intended to be as small and efficient as possible, trading features for a "
"smaller impact on cpu."
msgstr ""
"Janus ist ein einfacher, nativer Linux-Texteditor. Unterstützt UTF-8 und "
"Binärdaten durch seinen Fallback-Binär-Bearbeitungsmodus. Geistiger "
"Nachfolger von leafpad. Er soll so klein und effizient wie möglich sein und "
"verzichtet dafür auf Funktionen zugunsten einer geringeren CPU-Auslastung."

#: data/dev.pantheum.janus.metainfo.xml.in:28
msgid "Features include:"
msgstr "Funktionen:"

#: data/dev.pantheum.janus.metainfo.xml.in:30
msgid "Undo/redo"
msgstr "Rückgängig/Wiederholen"

#: data/dev.pantheum.janus.metainfo.xml.in:31
msgid "Similar keybinds to other text editors (e.g. leafpad)"
msgstr "Ähnliche Tastenkombinationen wie andere Texteditoren (z. B. leafpad)"

#: data/dev.pantheum.janus.metainfo.xml.in:32
msgid "Spanish/French/German Translations"
msgstr "Spanische/Französische/Deutsche Übersetzungen"

#: data/dev.pantheum.janus.metainfo.xml.in:33
msgid "Printing capabilities"
msgstr "Druckfunktionen"

#: data/dev.pantheum.janus.metainfo.xml.in:34
msgid "Optional syntax highlighting"
msgstr "Optionale Syntaxhervorhebung"

#: data/dev.pantheum.janus.metainfo.xml.in:35
msgid "Fallback binary editing"
msgstr "Binärbearbeitung als Rückfalloption"

#: data/dev.pantheum.janus.metainfo.xml.in:36
msgid "GVFS connectivity"
msgstr "GVFS-Anbindung"

#: data/dev.pantheum.janus.metainfo.xml.in:46
msgid "Picture of Janus reading a C file with syntax highlighting displayed"
msgstr "Bildschirmfoto von Janus mit einer C-Datei und Syntaxhervorhebung"

#: data/dev.pantheum.janus.metainfo.xml.in:90
