#: data/dev.pantheum.janus.metainfo.xml.in:5
msgid "Janus"
msgstr "Janus"

#: data/dev.pantheum.janus.metainfo.xml.in:6
msgid "Simple text editor"
msgstr "Basit metin düzenleyici"

#: data/dev.pantheum.janus.metainfo.xml.in:25
msgid ""
"Janus is a simple, native linux text editor. Supports UTF-8 and binary data "
"through its fallback binary editing mode. Spiritual successor to leafpad. "
"Intended to be as small and efficient as possible, trading features for a "
"smaller impact on cpu."
msgstr ""
"Janus, basit ve yerel bir Linux metin düzenleyicisidir. Yedek ikili "
"düzenleme kipi sayesinde UTF-8 ve ikili verileri destekler. leafpad'in "
"ruhani ardılıdır. İşlemci üzerindeki etkiyi azaltmak için özelliklerden ödün "
"vererek olabildiğince küçük ve verimli olması amaçlanmıştır."

#: data/dev.pantheum.janus.metainfo.xml.in:28
msgid "Features include:"
msgstr "Özellikler:"

#: data/dev.pantheum.janus.metainfo.xml.in:30
msgid "Undo/redo"
msgstr "Geri al/Yinele"

#: data/dev.pantheum.janus.metainfo.xml.in:31
msgid "Similar keybinds to other text editors (e.g. leafpad)"
msgstr "Diğer metin düzenleyicilerine benzer kısayol tuşları (örn. leafpad)"

#: data/dev.pantheum.janus.metainfo.xml.in:32
msgid "Spanish/French/German Translations"
msgstr "İspanyolca/Fransızca/Almanca çeviriler"

#: data/dev.pantheum.janus.metainfo.xml.in:33
msgid "Printing capabilities"
msgstr "Yazdırma özellikleri"

#: data/dev.pantheum.janus.metainfo.xml.in:34
msgid "Optional syntax highlighting"
msgstr "İsteğe bağlı sözdizimi vurgulama"

#: data/dev.pantheum.janus.metainfo.xml.in:35
msgid "Fallback binary editing"
msgstr "Yedek ikili düzenleme"

#: data/dev.pantheum.janus.metainfo.xml.in:36
msgid "GVFS connectivity"
msgstr "GVFS bağlantısı"

#: data/dev.pantheum.janus.metainfo.xml.in:46
msgid "Picture of Janus reading a C file with syntax highlighting displayed"
msgstr ""
"Janus'ın sözdizimi vurgulamalı bir C dosyasını gösteren ekran görüntüsü"

#: data/dev.pantheum.janus.metainfo.xml.in:90
#: data/dev.pantheum.janus.metainfo.xml.in:111
msgid "Major changes:"
msgstr "Önemli değişiklikler:"

#: data/dev.pantheum.janus.metainfo.xml.in:92
msgid "Rpm build added"
msgstr "Rpm derlemesi eklendi"

#: data/dev.pantheum.janus.metainfo.xml.in:93
msgid "AppImage, rpm, and deb packages now available as arm64"
msgstr "AppImage, rpm ve deb paketleri artık arm64 olarak da mevcut"

#: data/dev.pantheum.janus.metainfo.xml.in:95
#: data/dev.pantheum.janus.metainfo.xml.in:116
msgid "Minor changes:"
msgstr "Küçük değişiklikler:"

#: data/dev.pantheum.janus.metainfo.xml.in:97
msgid "Search settings persistent during a session"
msgstr "Arama ayarları oturum boyunca korunuyor"

#: data/dev.pantheum.janus.metainfo.xml.in:98
msgid "Dutch translations added"
msgstr "Hollandaca çeviriler eklendi"

#: data/dev.pantheum.janus.metainfo.xml.in:99
msgid "Auditable builds via GitHub Actions"
msgstr "GitHub Actions üzerinden denetlenebilir derlemeler"

#: data/dev.pantheum.janus.metainfo.xml.in:100
msgid "Metainfo translations added"
msgstr "Metainfo çevirileri eklendi"

#: data/dev.pantheum.janus.metainfo.xml.in:101
msgid "Listed on appimagehub"
msgstr "appimagehub'da listelendi"

#: data/dev.pantheum.janus.metainfo.xml.in:102
msgid "AppImage using fuse 3, signed"
msgstr "AppImage artık fuse 3 kullanıyor ve imzalanıyor"

#: data/dev.pantheum.janus.metainfo.xml.in:103
msgid "AppImage now twice as small 2 MB => 1 MB"
msgstr "AppImage şimdi yarı yarıya küçüldü: 2 MB => 1 MB"

#: data/dev.pantheum.janus.metainfo.xml.in:104
msgid "Flatpak over 1 MB smaller as well"
msgstr "Flatpak da 1 MB'tan fazla küçüldü"

#: data/dev.pantheum.janus.metainfo.xml.in:105
msgid ""
"4 new languages supported by syntax highlighting: Lean, SPICE, STAR, "
"Terraform"
msgstr ""
"Sözdizimi vurgulama artık 4 yeni dili destekliyor: Lean, SPICE, STAR, "
"Terraform"

#: data/dev.pantheum.janus.metainfo.xml.in:113
msgid "Now available as flatpak"
msgstr "Artık flatpak olarak mevcut"

#: data/dev.pantheum.janus.metainfo.xml.in:114
msgid "Soon to be on flathub and appimagehub"
msgstr "Yakında flathub ve appimagehub'da"

#: data/dev.pantheum.janus.metainfo.xml.in:118
msgid "Turkish translations added"
msgstr "Türkçe çeviriler eklendi"

#: data/dev.pantheum.janus.metainfo.xml.in:119
msgid "Switched from make to meson"
msgstr "Make'ten meson'a geçildi"

#: data/dev.pantheum.janus.metainfo.xml.in:120
msgid "Print line numbers"
msgstr "Satır numaralarını yazdırma"

#: data/dev.pantheum.janus.metainfo.xml.in:121
msgid "Can now pipe text into janus"
msgstr "Artık janus'a metin pipe'lanabiliyor"

#: data/dev.pantheum.janus.metainfo.xml.in:122
msgid "Use native file chooser"
msgstr "Yerel dosya seçici kullanımı"

#: data/dev.pantheum.janus.metainfo.xml.in:123
msgid "New app id, new website pantheum.dev"
msgstr "Yeni uygulama kimliği, yeni web sitesi pantheum.dev"

#: data/dev.pantheum.janus.metainfo.xml.in:124
msgid "Minor bug where line numbers were light on dark mode fixed"
msgstr ""
"Karanlık modda satır numaralarının çok açık renkte görünmesine neden olan "
"küçük hata düzeltildi"

#: data/dev.pantheum.janus.metainfo.xml.in:125
msgid "No more print preview"
msgstr "Yazdırma önizlemesi kaldırıldı"
