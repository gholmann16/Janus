#: data/dev.pantheum.janus.metainfo.xml.in:5
msgid "Janus"
msgstr "Janus"

#: data/dev.pantheum.janus.metainfo.xml.in:6
msgid "Simple text editor"
msgstr "Éditeur de texte simple"

#: data/dev.pantheum.janus.metainfo.xml.in:25
msgid ""
"Janus is a simple, native linux text editor. Supports UTF-8 and binary data "
"through its fallback binary editing mode. Spiritual successor to leafpad. "
"Intended to be as small and efficient as possible, trading features for a "
"smaller impact on cpu."
msgstr ""
"Janus est un éditeur de texte simple et natif pour Linux. Prend en charge "
"l'UTF-8 et les données binaires grâce à son mode d'édition binaire de repli. "
"Successeur spirituel de leafpad. Conçu pour être aussi petit et efficace que "
"possible, en sacrifiant des fonctionnalités pour réduire l'impact sur le "
"processeur."

#: data/dev.pantheum.janus.metainfo.xml.in:28
msgid "Features include:"
msgstr "Fonctionnalités :"

#: data/dev.pantheum.janus.metainfo.xml.in:30
msgid "Undo/redo"
msgstr "Annuler/Rétablir"

#: data/dev.pantheum.janus.metainfo.xml.in:31
msgid "Similar keybinds to other text editors (e.g. leafpad)"
msgstr ""
"Raccourcis clavier similaires aux autres éditeurs de texte (par ex. leafpad)"

#: data/dev.pantheum.janus.metainfo.xml.in:32
msgid "Spanish/French/German Translations"
msgstr "Traductions en espagnol/français/allemand"

#: data/dev.pantheum.janus.metainfo.xml.in:33
msgid "Printing capabilities"
msgstr "Fonctionnalités d'impression"

#: data/dev.pantheum.janus.metainfo.xml.in:34
msgid "Optional syntax highlighting"
msgstr "Coloration syntaxique facultative"

#: data/dev.pantheum.janus.metainfo.xml.in:35
msgid "Fallback binary editing"
msgstr "Édition binaire de secours"

#: data/dev.pantheum.janus.metainfo.xml.in:36
msgid "GVFS connectivity"
msgstr "Connectivité GVFS"

#: data/dev.pantheum.janus.metainfo.xml.in:46
msgid "Picture of Janus reading a C file with syntax highlighting displayed"
msgstr "Capture de Janus affichant un fichier C avec coloration syntaxique"

#: data/dev.pantheum.janus.metainfo.xml.in:90
#: data/dev.pantheum.janus.metainfo.xml.in:111
msgid "Major changes:"
msgstr "Changements majeurs :"

#: data/dev.pantheum.janus.metainfo.xml.in:92
msgid "Rpm build added"
msgstr "Ajout de la compilation rpm"

#: data/dev.pantheum.janus.metainfo.xml.in:93
msgid "AppImage, rpm, and deb packages now available as arm64"
msgstr "Les paquets AppImage, rpm et deb sont désormais aussi disponibles en arm64"

#: data/dev.pantheum.janus.metainfo.xml.in:95
#: data/dev.pantheum.janus.metainfo.xml.in:116
msgid "Minor changes:"
msgstr "Changements mineurs :"

#: data/dev.pantheum.janus.metainfo.xml.in:97
msgid "Search settings persistent during a session"
msgstr "Les paramètres de recherche persistent pendant une session"

#: data/dev.pantheum.janus.metainfo.xml.in:98
msgid "Dutch translations added"
msgstr "Ajout des traductions néerlandaises"

#: data/dev.pantheum.janus.metainfo.xml.in:99
msgid "Auditable builds via GitHub Actions"
msgstr "Compilations auditables via GitHub Actions"

#: data/dev.pantheum.janus.metainfo.xml.in:100
msgid "Metainfo translations added"
msgstr "Ajout des traductions du metainfo"

#: data/dev.pantheum.janus.metainfo.xml.in:101
msgid "Listed on appimagehub"
msgstr "Répertorié sur appimagehub"

#: data/dev.pantheum.janus.metainfo.xml.in:102
